rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Flight Run Submissions: Anyone can read, authenticated or guest can post positive scores
    match /cosmic_leaderboard/{runId} {
      allow read: if true;
      allow create: if request.resource.data.score is number 
                    && request.resource.data.score > 0
                    && request.resource.data.pilotName is string;
      allow update, delete: if false; // Flight logs are immutable records
    }

    // User Career Profiles: Publicly readable, writeable only by the owner
    match /cosmic_users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   || request.resource.data.userId == userId;
    }
  }
}
